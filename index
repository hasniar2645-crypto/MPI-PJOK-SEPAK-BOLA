<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MPI PJOK Kelas VII — Sepak Bola</title>
<style>
:root{--green:#176b45;--green2:#218653;--lime:#d9f99d;--ink:#15251d;--muted:#5d6b63;--paper:#f4f8f3;--white:#fff;--orange:#ffb454;--red:#b93838;--line:#dce7dd;--shadow:0 12px 32px #12352212}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--paper);color:var(--ink);line-height:1.55}button,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #f3a63b;outline-offset:3px}
.topbar{position:sticky;top:0;z-index:20;background:#104a31;color:white;padding:10px 4vw;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 3px 12px #0002}.brand{display:flex;gap:10px;align-items:center;font-weight:800}.ball{font-size:28px}.top-actions{display:flex;gap:8px;align-items:center}.tiny{border:1px solid #ffffff66;background:#ffffff12;color:white;padding:7px 10px;border-radius:10px}
.progress-wrap{height:4px;background:#dbe9dd}.progress{height:100%;width:0;background:var(--orange);transition:width .3s}
main{max-width:1120px;margin:auto;padding:24px 18px 52px}.screen{display:none;animation:rise .25s ease}.screen.active{display:block}@keyframes rise{from{opacity:.3;transform:translateY(7px)}to{opacity:1;transform:none}}
.hero{border-radius:28px;overflow:hidden;background:linear-gradient(120deg,#104a31,#218653);color:white;display:grid;grid-template-columns:1.2fr .8fr;min-height:360px;box-shadow:var(--shadow)}.hero-copy{padding:clamp(24px,5vw,56px)}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.76rem;font-weight:800;color:#d9f99d}.hero h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.06;margin:12px 0}.hero p{max-width:620px;color:#e3f5e8}.hero-art{display:grid;place-items:center;position:relative;overflow:hidden;background:radial-gradient(circle at 60% 35%,#69c48a,#176b45 65%)}.hero-art:before{content:"";position:absolute;width:330px;height:330px;border:2px solid #ffffff45;border-radius:50%}.hero-art:after{content:"";position:absolute;width:220px;height:220px;border:2px solid #ffffff45;border-radius:50%}.giant-ball{font-size:clamp(100px,17vw,180px);z-index:1;filter:drop-shadow(0 16px 8px #06331d66);transform:rotate(-12deg)}
h1,h2,h3{line-height:1.2}h2{font-size:clamp(1.5rem,3vw,2.2rem);margin:0 0 10px}h3{margin:0 0 8px}.muted{color:var(--muted)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:30px 0 16px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card{background:white;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:var(--shadow)}.card-icon{font-size:32px;margin-bottom:8px}.card p{color:var(--muted);margin-top:6px}.btn{border:0;border-radius:12px;padding:11px 16px;font-weight:750;background:var(--green);color:white;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:transform .12s,background .12s}.btn:hover{background:#0f5435;transform:translateY(-1px)}.btn.secondary{background:#e5f3e8;color:#145638}.btn.light{background:white;color:#145638}.btn.outline{background:transparent;border:1px solid var(--line);color:var(--ink)}.btn.warn{background:#fff0d8;color:#7c4700}.btn-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.pill{display:inline-block;padding:5px 10px;background:#e8f5eb;color:#145638;border-radius:999px;font-size:.8rem;font-weight:750}.note{border-left:4px solid var(--orange);background:#fff7e8;padding:13px 15px;border-radius:8px;margin:14px 0}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.tab{border:1px solid var(--line);background:white;padding:9px 14px;border-radius:999px;font-weight:700;color:var(--ink)}.tab.active{background:var(--green);color:white;border-color:var(--green)}
.lesson-layout{display:grid;grid-template-columns:260px 1fr;gap:18px}.lesson-nav{align-self:start;position:sticky;top:86px}.lesson-nav button{display:block;width:100%;text-align:left;margin:5px 0}.lesson-panel{min-height:300px}.lesson-panel img{max-width:100%}.tech-visual{min-height:155px;background:linear-gradient(135deg,#d8f3df,#f4fbe9);border-radius:16px;display:grid;place-items:center;font-size:76px;margin-bottom:15px}.steps{padding-left:22px}.steps li{padding:5px 0}.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}.good{border:1px solid #b9e2c4;background:#f0fbf2;border-radius:14px;padding:14px}.bad{border:1px solid #f1d1b2;background:#fff8ef;border-radius:14px;padding:14px}
.scenario{background:linear-gradient(135deg,#153d2c,#247c4d);color:white;border-radius:22px;padding:24px}.scenario p{color:#e0f4e5}.choices{display:grid;gap:10px;margin:18px 0}.choice{background:white;color:var(--ink);border:2px solid transparent;border-radius:13px;padding:13px 15px;text-align:left}.choice:hover{border-color:#8bc99e}.choice.selected{border-color:var(--green);background:#e9f7ed}.feedback{padding:13px;border-radius:12px;margin-top:12px}.feedback.correct{background:#e6f8eb;color:#125b31}.feedback.incorrect{background:#fff0e3;color:#804600}
.question{padding:18px;border:1px solid var(--line);border-radius:17px;background:white;margin:14px 0}.question legend{font-weight:800;padding:0 5px}.question label{display:block;padding:9px 11px;border-radius:10px;margin:5px 0;background:#f5f8f5;cursor:pointer}.question label:hover{background:#e8f4eb}.question input{margin-right:8px;accent-color:var(--green)}.result-score{font-size:3rem;font-weight:900;color:var(--green)}textarea{width:100%;min-height:110px;border:1px solid #cad8cd;border-radius:12px;padding:12px;resize:vertical;background:white}.field{display:block;font-weight:750;margin:12px 0 6px}.checkline{display:flex;gap:9px;align-items:flex-start;margin:10px 0}.checkline input{margin-top:6px;accent-color:var(--green)}
footer{border-top:1px solid var(--line);padding:20px;text-align:center;color:var(--muted);font-size:.9rem}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#15251d;color:white;padding:11px 16px;border-radius:12px;display:none;z-index:50;box-shadow:var(--shadow)}
@media(max-width:760px){.hero{grid-template-columns:1fr}.hero-art{min-height:190px}.giant-ball{font-size:115px}.grid{grid-template-columns:1fr}.lesson-layout{grid-template-columns:1fr}.lesson-nav{position:static;display:flex;gap:6px;overflow:auto}.lesson-nav button{white-space:nowrap;width:auto}.compare{grid-template-columns:1fr}.topbar{padding:9px 12px}.brand span:last-child{font-size:.9rem}.top-actions .tiny{font-size:.8rem;padding:6px 8px}}
@media print{.topbar,.btn,.tabs,.lesson-nav,footer{display:none!important}body{background:white}.screen{display:block!important;page-break-after:always}.card{box-shadow:none}}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand"><span class="ball">⚽</span><span>MPI PJOK • Kelas VII</span></div>
  <div class="top-actions"><button class="tiny" id="audioBtn" aria-pressed="false" title="Aktifkan atau nonaktifkan bunyi">🔇 Suara</button><button class="tiny" onclick="showScreen('home')">⌂ Beranda</button></div>
</header>
<div class="progress-wrap" aria-label="Progres belajar"><div class="progress" id="progress"></div></div>
<main>
  <section class="screen active" id="home">
    <div class="hero">
      <div class="hero-copy"><div class="eyebrow">Media Pembelajaran Interaktif</div><h1>Jago Sepak Bola:<br>Passing, Dribbling, Shooting</h1><p>Belajar teknik dasar sepak bola, mencoba simulasi situasi permainan, lalu menguji pemahamanmu. Siap bermain cerdas dan sportif?</p><div class="btn-row"><button class="btn light" onclick="showScreen('goals')">Mulai belajar →</button><button class="btn secondary" onclick="showScreen('simulation')">Coba simulasi</button></div><p style="font-size:.85rem;margin-top:22px">PJOK • SMP/MTs Kelas VII • Fase D</p></div>
      <div class="hero-art" aria-hidden="true"><div class="giant-ball">⚽</div></div>
    </div>
    <div class="section-head"><div><h2>Jalur belajarmu</h2><p class="muted">Ikuti langkah berikut sesuai urutan atau pilih bagian yang ingin kamu pelajari.</p></div></div>
    <div class="grid">
      <article class="card"><div class="card-icon">🎯</div><h3>1. Tujuan belajar</h3><p>Ketahui kemampuan yang akan kamu capai.</p><button class="btn secondary" onclick="showScreen('goals')">Lihat tujuan</button></article>
      <article class="card"><div class="card-icon">📘</div><h3>2. Materi teknik</h3><p>Pelajari prinsip passing, dribbling, dan shooting.</p><button class="btn secondary" onclick="showScreen('material')">Pelajari materi</button></article>
      <article class="card"><div class="card-icon">🕹️</div><h3>3. Laboratorium virtual</h3><p>Pilih tindakan terbaik dalam situasi permainan.</p><button class="btn secondary" onclick="showScreen('simulation')">Mulai simulasi</button></article>
      <article class="card"><div class="card-icon">📝</div><h3>4. Kuis</h3><p>Uji pemahamanmu melalui 5 soal pilihan ganda.</p><button class="btn secondary" onclick="showScreen('quiz')">Kerjakan kuis</button></article>
      <article class="card"><div class="card-icon">💭</div><h3>5. Refleksi</h3><p>Rencanakan latihan dan sikap sportifmu.</p><button class="btn secondary" onclick="showScreen('reflection')">Isi refleksi</button></article>
      <article class="card"><div class="card-icon">📊</div><h3>6. Hasil belajar</h3><p>Lihat progres simulasi dan nilai kuis.</p><button class="btn secondary" onclick="showScreen('results')">Lihat hasil</button></article>
    </div>
    <div class="note"><strong>Ingat:</strong> media ini membantu memahami keputusan dan prinsip teknik. Kemampuan gerak tetap perlu dilatih serta dinilai langsung oleh guru dengan memperhatikan keselamatan.</div>
  </section>

  <section class="screen" id="goals">
    <span class="pill">Orientasi</span><h2 style="margin-top:12px">Tujuan pembelajaran</h2><p class="muted">Setelah menyelesaikan media ini, kamu diharapkan mampu:</p>
    <div class="card"><ol class="steps"><li>Menjelaskan fungsi dan prinsip dasar <strong>passing</strong>, <strong>dribbling</strong>, dan <strong>shooting</strong>.</li><li>Memilih teknik yang sesuai dengan situasi permainan sederhana.</li><li>Mengidentifikasi unsur keselamatan, kerja sama, tanggung jawab, dan sportivitas.</li><li>Menyusun satu target latihan pribadi yang realistis.</li></ol></div>
    <div class="section-head"><div><h2>Petunjuk penggunaan</h2><p class="muted">Gunakan tombol untuk berpindah bagian. Kuis dapat diulang.</p></div></div>
    <div class="grid"><div class="card"><h3>⏱️ Waktu</h3><p>Perkiraan 15–25 menit untuk membaca materi, simulasi, dan kuis.</p></div><div class="card"><h3>🧭 Cara belajar</h3><p>Baca materi, pikirkan alasan pilihanmu, lalu cek umpan balik.</p></div><div class="card"><h3>🛡️ Keselamatan</h3><p>Latihan gerak dilakukan di area aman, dengan jarak cukup dan mengikuti arahan guru.</p></div></div>
    <div class="btn-row"><button class="btn" onclick="showScreen('material')">Lanjut ke materi →</button><button class="btn outline" onclick="showScreen('home')">Kembali</button></div>
  </section>

  <section class="screen" id="material">
    <span class="pill">Materi inti</span><h2 style="margin-top:12px">Tiga teknik dasar sepak bola</h2><p class="muted">Pilih tab teknik. Baca langkah-langkah, perhatikan kesalahan umum, lalu jawab pertanyaan cek pemahaman.</p>
    <div class="tabs" role="tablist" aria-label="Pilih teknik"><button class="tab active" data-tech="passing" role="tab" aria-selected="true">⚽ Passing</button><button class="tab" data-tech="dribbling" role="tab" aria-selected="false">🏃 Dribbling</button><button class="tab" data-tech="shooting" role="tab" aria-selected="false">🥅 Shooting</button></div>
    <div class="card lesson-panel" id="lessonPanel"></div>
    <div class="btn-row"><button class="btn" onclick="showScreen('simulation')">Coba di simulasi →</button><button class="btn outline" onclick="showScreen('goals')">Tujuan belajar</button></div>
  </section>

  <section class="screen" id="simulation">
    <span class="pill">Laboratorium virtual</span><h2 style="margin-top:12px">Pilih tindakan terbaik</h2><p class="muted">Baca situasi, pilih satu tindakan, kemudian periksa umpan baliknya. Ada 3 skenario.</p>
    <div class="scenario"><div id="scenarioCount" class="eyebrow">Skenario 1 dari 3</div><h2 id="scenarioTitle">Rekan satu tim terbuka</h2><p id="scenarioText">Seorang teman berada di ruang kosong. Lawan mulai mendekat dan kamu ingin mengoper bola dengan akurat.</p></div>
    <div class="choices" id="scenarioChoices"></div><div id="scenarioFeedback" aria-live="polite"></div>
    <div class="btn-row"><button class="btn" id="nextScenario" disabled onclick="nextScenarioAction()">Skenario berikutnya →</button><button class="btn outline" onclick="showScreen('material')">Baca materi lagi</button></div>
    <p class="muted" id="simScoreLine">Skor simulasi: 0/30</p>
  </section>

  <section class="screen" id="quiz">
    <span class="pill">Evaluasi formatif</span><h2 style="margin-top:12px">Kuis pemahaman</h2><p class="muted">Pilih satu jawaban paling tepat pada setiap soal. Nilai dihitung setelah tombol “Periksa jawaban” ditekan.</p>
    <form id="quizForm"><div id="quizQuestions"></div><div class="btn-row"><button type="submit" class="btn">Periksa jawaban</button><button type="button" class="btn outline" onclick="resetQuiz()">Ulangi kuis</button></div></form><div id="quizResult" aria-live="polite"></div>
  </section>

  <section class="screen" id="reflection">
    <span class="pill">Refleksi diri</span><h2 style="margin-top:12px">Pikirkan perkembanganmu</h2><p class="muted">Jawab dengan jujur. Refleksi ini untuk membantu menentukan latihan berikutnya.</p>
    <div class="card">
      <label class="field" for="understand">1. Teknik mana yang paling kamu pahami?</label><div class="checkline"><input type="radio" name="understand" value="Passing" id="rpass"><label for="rpass">Passing</label></div><div class="checkline"><input type="radio" name="understand" value="Dribbling" id="rdrib"><label for="rdrib">Dribbling</label></div><div class="checkline"><input type="radio" name="understand" value="Shooting" id="rshoot"><label for="rshoot">Shooting</label></div>
      <label class="field" for="challenge">2. Bagian apa yang masih menantang bagimu?</label><textarea id="challenge" placeholder="Contoh: mengarahkan bola saat passing..."></textarea>
      <label class="field" for="target">3. Apa target latihanmu berikutnya?</label><textarea id="target" placeholder="Contoh: melakukan 10 passing terarah dengan teman..."></textarea>
      <label class="checkline"><input type="checkbox" id="sportive"> Saya akan menghargai teman, mengikuti aturan, dan menjaga keselamatan saat latihan.</label>
      <div class="btn-row"><button type="button" class="btn" onclick="saveReflection()">Simpan refleksi di sesi ini</button><button type="button" class="btn secondary" onclick="copyReflection()">Salin refleksi</button></div><div id="reflectionFeedback" aria-live="polite"></div>
    </div>
  </section>

  <section class="screen" id="results">
    <span class="pill">Ringkasan</span><h2 style="margin-top:12px">Hasil belajarmu</h2><p class="muted">Ringkasan ini diperbarui selama kamu menggunakan media pada perangkat ini.</p>
    <div class="grid"><div class="card"><div class="card-icon">🕹️</div><p>Skor simulasi</p><div class="result-score" id="resultSim">0/30</div><p id="simSummary">Selesaikan 3 skenario untuk melihat hasil.</p></div><div class="card"><div class="card-icon">📝</div><p>Nilai kuis</p><div class="result-score" id="resultQuiz">—</div><p id="quizSummary">Belum ada kuis yang diperiksa.</p></div><div class="card"><div class="card-icon">💭</div><p>Refleksi</p><div class="result-score" id="resultReflection">—</div><p id="reflectionSummary">Belum disimpan.</p></div></div>
    <div class="card" style="margin-top:16px"><h3>Langkah selanjutnya</h3><p>Gunakan hasil ini untuk menentukan latihan. Minta guru atau teman memberi umpan balik pada ketepatan arah bola, kontrol, keseimbangan, dan kerja sama.</p><div class="btn-row"><button class="btn" onclick="showScreen('material')">Ulangi materi</button><button class="btn secondary" onclick="showScreen('quiz')">Ulangi kuis</button><button class="btn outline" onclick="window.print()">Cetak ringkasan / Simpan PDF</button></div></div>
  </section>
</main>
<footer>MPI PJOK Kelas VII • Sepak Bola • Passing, Dribbling, Shooting<br>Media pembelajaran mandiri — gunakan bersama bimbingan guru PJOK.</footer>
<div class="toast" id="toast" role="status"></div>
<script>
const state={screen:'home',tech:'passing',scenario:0,scenarioAnswers:{},simScore:0,quizScore:null,quizSubmitted:false,reflectionSaved:false,audio:false};
const lessons={
passing:{icon:'🦶',title:'Passing — mengoper bola',intro:'Passing adalah mengirim bola kepada rekan satu tim agar permainan tetap terhubung dan peluang tercipta.',steps:['Arahkan pandangan ke bola dan sasaran/rekan yang akan menerima operan.','Letakkan kaki tumpu di samping bola, ujung kaki mengarah ke sasaran.','Untuk operan pendek yang akurat, gunakan kaki bagian dalam; pergelangan kaki dikunci dan badan seimbang.','Ayunkan kaki ke arah bola, lanjutkan gerak ke sasaran, lalu bergerak mencari ruang.'],good:'Operan terarah ke kaki atau ruang yang mudah dijangkau rekan.',bad:'Menendang tanpa melihat sasaran atau berdiri diam setelah mengoper.',check:'Untuk operan pendek yang akurat, bagian kaki mana yang biasanya digunakan?',options:['Kaki bagian dalam','Tumit saja','Ujung jari kaki'],answer:0,why:'Kaki bagian dalam memberi bidang sentuh yang relatif lebar sehingga mudah mengarahkan operan pendek.'},
dribbling:{icon:'🏃',title:'Dribbling — menggiring bola',intro:'Dribbling adalah membawa bola sambil bergerak, dengan sentuhan terkontrol untuk mempertahankan penguasaan dan mencari ruang.',steps:['Gunakan sentuhan pendek agar bola tetap dekat ketika ruang sempit.','Pakai kaki bagian dalam atau luar sesuai arah gerak; punggung kaki dapat digunakan untuk mendorong bola ke ruang terbuka.','Angkat pandangan secara berkala untuk melihat lawan, rekan, dan ruang kosong.','Ubah arah atau kecepatan seperlunya; jika rekan lebih bebas, pertimbangkan mengoper.'],good:'Bola tetap dalam jangkauan dan pemain melihat situasi sekitar.',bad:'Mendorong bola terlalu jauh atau terus menatap bola hingga tak melihat lawan.',check:'Apa prinsip utama ketika menggiring bola di ruang sempit?',options:['Sentuhan terkontrol dan bola tetap dekat','Menendang bola sejauh mungkin','Selalu melihat bola tanpa mengangkat kepala'],answer:0,why:'Sentuhan terkontrol membuat bola mudah dikuasai dan membantu pemain merespons situasi.'},
shooting:{icon:'🥅',title:'Shooting — menembak ke gawang',intro:'Shooting adalah usaha menendang bola ke arah gawang untuk mencetak gol. Teknik dipilih sesuai jarak, posisi, dan sasaran.',steps:['Amati posisi gawang dan penjaga gawang sebelum menendang.','Letakkan kaki tumpu di samping bola dan jaga keseimbangan.','Gunakan punggung kaki untuk tendangan kuat atau kaki bagian dalam untuk tendangan yang lebih terarah, sesuai kebutuhan.','Arahkan badan dan ayunan ke sasaran, lalu lanjutkan gerak dengan seimbang.'],good:'Pemain memilih sasaran, menempatkan kaki tumpu dengan stabil, dan mengontrol arah tendangan.',bad:'Menendang terburu-buru tanpa melihat sasaran atau kehilangan keseimbangan.',check:'Apa yang sebaiknya dilakukan sebelum melakukan shooting?',options:['Mengamati sasaran dan posisi penjaga gawang','Menutup mata agar fokus','Selalu menendang sekuat-kuatnya'],answer:0,why:'Mengamati sasaran membantu memilih arah dan jenis tendangan yang sesuai.'}
};
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='block';clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>t.style.display='none',2400)}
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active',s.id===id));state.screen=id;window.scrollTo({top:0,behavior:'smooth'});updateProgress();if(id==='results')updateResults();if(id==='material')renderLesson(state.tech)}
function updateProgress(){const map={home:0,goals:10,material:30,simulation:55,quiz:80,reflection:90,results:100};document.getElementById('progress').style.width=(map[state.screen]||0)+'%'}
function renderLesson(key){state.tech=key;const l=lessons[key];document.querySelectorAll('[data-tech]').forEach(b=>{const on=b.dataset.tech===key;b.classList.toggle('active',on);b.setAttribute('aria-selected',String(on))});document.getElementById('lessonPanel').innerHTML=`<div class="tech-visual" aria-hidden="true">${l.icon}</div><h2>${l.title}</h2><p>${l.intro}</p><h3>Langkah utama</h3><ol class="steps">${l.steps.map(s=>`<li>${s}</li>`).join('')}</ol><div class="compare"><div class="good"><strong>✅ Ciri yang baik</strong><p>${l.good}</p></div><div class="bad"><strong>⚠️ Hindari</strong><p>${l.bad}</p></div></div><div class="note"><strong>Cek pemahaman:</strong> ${l.check}<div class="choices">${l.options.map((o,i)=>`<button class="choice" onclick="checkLesson('${key}',${i},this)">${String.fromCharCode(97+i)}. ${o}</button>`).join('')}</div><div id="lessonFeedback" aria-live="polite"></div></div>`}
function checkLesson(key,i,btn){const l=lessons[key];const box=document.getElementById('lessonFeedback');box.className='feedback '+(i===l.answer?'correct':'incorrect');box.textContent=(i===l.answer?'Benar! ':'Belum tepat. ')+l.why;btn.parentElement.querySelectorAll('button').forEach(b=>b.disabled=true)}
document.querySelectorAll('[data-tech]').forEach(b=>b.addEventListener('click',()=>renderLesson(b.dataset.tech)));
const scenarios=[
{title:'Rekan satu tim terbuka',text:'Seorang teman berada di ruang kosong. Lawan mulai mendekat dan kamu ingin mengoper bola dengan akurat.',options:['Menggunakan kaki bagian dalam dan mengarahkan operan ke ruang teman.','Menendang bola sekuat mungkin tanpa melihat arah.','Membawa bola terus meskipun jalur operan terbuka.'],correct:0,explain:'Passing dengan kaki bagian dalam membantu mengarahkan operan pendek secara akurat. Lihat sasaran dan sesuaikan kekuatan.'},
{title:'Ruang mulai sempit',text:'Kamu menggiring bola dan seorang lawan mendekat. Ada beberapa cone di depan yang mewakili rintangan.',options:['Mendorong bola jauh ke depan lalu berlari mengejarnya.','Menjaga sentuhan pendek, mengubah arah, dan melihat ruang yang aman.','Menunduk terus melihat bola dan bergerak lurus.'],correct:1,explain:'Dribbling yang baik menjaga bola tetap dekat, mengontrol arah, dan mengangkat pandangan untuk membaca situasi.'},
{title:'Peluang menembak',text:'Kamu berada di dekat area gawang. Ada ruang di sisi gawang dan penjaga gawang berada agak ke tengah.',options:['Menutup mata dan menendang sekuat mungkin.','Mengamati sasaran, menempatkan kaki tumpu, lalu menendang terarah.','Mengoper bola ke belakang tanpa melihat pilihan lain.'],correct:1,explain:'Shooting efektif memerlukan pengamatan sasaran, keseimbangan, kaki tumpu yang stabil, dan arah tendangan yang terkontrol.'}
];
function renderScenario(){const s=scenarios[state.scenario];document.getElementById('scenarioCount').textContent=`Skenario ${state.scenario+1} dari ${scenarios.length}`;document.getElementById('scenarioTitle').textContent=s.title;document.getElementById('scenarioText').textContent=s.text;document.getElementById('scenarioChoices').innerHTML=s.options.map((o,i)=>`<button class="choice" onclick="answerScenario(${i},this)" ${state.scenarioAnswers[state.scenario]!==undefined?'disabled':''}>${String.fromCharCode(97+i)}. ${o}</button>`).join('');const f=document.getElementById('scenarioFeedback');if(state.scenarioAnswers[state.scenario]!==undefined){const a=state.scenarioAnswers[state.scenario];f.className='feedback '+(a===s.correct?'correct':'incorrect');f.textContent=(a===s.correct?'Tepat! ':'Coba pahami kembali. ')+s.explain}else{f.className='';f.textContent=''}document.getElementById('nextScenario').disabled=state.scenarioAnswers[state.scenario]===undefined;document.getElementById('nextScenario').textContent=state.scenario===2?'Lihat hasil →':'Skenario berikutnya →';document.getElementById('simScoreLine').textContent=`Skor simulasi: ${state.simScore}/30`}
function answerScenario(i,btn){const s=scenarios[state.scenario];if(state.scenarioAnswers[state.scenario]!==undefined)return;state.scenarioAnswers[state.scenario]=i;if(i===s.correct)state.simScore+=10;document.querySelectorAll('#scenarioChoices .choice').forEach(b=>b.disabled=true);btn.classList.add('selected');renderScenario();document.querySelectorAll('#scenarioChoices .choice')[i].classList.add('selected');updateResults()}
function nextScenarioAction(){if(state.scenario<2){state.scenario++;renderScenario()}else{showScreen('results');showToast('Simulasi selesai. Lihat ringkasan hasilmu.')}}
const quizData=[
{q:'Bagian kaki yang umum digunakan untuk passing pendek yang akurat adalah …',opts:['Kaki bagian dalam','Tumit saja','Lutut'],a:0,why:'Kaki bagian dalam memberi bidang sentuh lebar untuk mengarahkan operan.'},
{q:'Ketika melakukan dribbling, pemain sebaiknya …',opts:['Menendang bola sejauh mungkin setiap sentuhan','Menjaga bola terkontrol dan melihat ruang sekitar','Selalu melihat bola tanpa memperhatikan lawan'],a:1,why:'Kontrol bola dan pengamatan situasi membantu pemain menjaga penguasaan.'},
{q:'Sebelum shooting, pemain sebaiknya …',opts:['Mengamati sasaran dan menempatkan kaki tumpu dengan stabil','Menutup mata lalu menendang','Selalu menendang sekuat mungkin'],a:0,why:'Sasaran dan keseimbangan membantu mengarahkan tendangan dengan lebih baik.'},
{q:'Teman satu tim berada di posisi bebas dan jalur operan terbuka. Keputusan yang masuk akal adalah …',opts:['Tetap menggiring tanpa melihat situasi','Melakukan passing terarah kepada teman','Menendang bola ke luar lapangan'],a:1,why:'Passing dapat mempertahankan penguasaan dan memanfaatkan posisi rekan yang bebas.'},
{q:'Saat latihan sepak bola, sikap yang tepat adalah …',opts:['Mengejek teman yang salah','Mengabaikan instruksi keselamatan','Bekerja sama, menghormati lawan, dan mengikuti aturan'],a:2,why:'Keselamatan, kerja sama, dan sportivitas merupakan bagian penting pembelajaran PJOK.'}
];
function renderQuiz(){document.getElementById('quizQuestions').innerHTML=quizData.map((q,i)=>`<fieldset class="question"><legend>${i+1}. ${q.q}</legend>${q.opts.map((o,j)=>`<label><input type="radio" name="q${i}" value="${j}" ${state.quizSubmitted?'disabled':''}>${String.fromCharCode(97+j)}. ${o}</label>`).join('')}<div id="qfeedback${i}"></div></fieldset>`).join('')}
document.getElementById('quizForm').addEventListener('submit',e=>{e.preventDefault();let correct=0,answered=0;quizData.forEach((q,i)=>{const chosen=document.querySelector(`input[name="q${i}"]:checked`);const f=document.getElementById('qfeedback'+i);if(chosen){answered++;if(Number(chosen.value)===q.a)correct++;f.className='feedback '+(Number(chosen.value)===q.a?'correct':'incorrect');f.textContent=(Number(chosen.value)===q.a?'Benar. ':'Belum tepat. ')+q.why}else{f.className='feedback incorrect';f.textContent='Belum dijawab. '+q.why}});state.quizScore=Math.round(correct/quizData.length*100);state.quizSubmitted=true;document.querySelectorAll('#quizForm input').forEach(i=>i.disabled=true);document.getElementById('quizResult').innerHTML=`<div class="card" style="margin-top:16px"><h3>Hasil kuis</h3><div class="result-score">${state.quizScore}</div><p>Nilai ${correct} dari ${quizData.length} jawaban benar. ${state.quizScore>=80?'Bagus! Pertahankan pemahamanmu.':state.quizScore>=60?'Cukup baik. Baca kembali bagian yang belum dikuasai.':'Ayo pelajari lagi materi, lalu coba ulangi kuis.'}</p><button class="btn secondary" onclick="showScreen('results')">Lihat ringkasan</button></div>`;updateResults();showToast('Jawaban kuis sudah diperiksa.')});
function resetQuiz(){state.quizScore=null;state.quizSubmitted=false;renderQuiz();document.getElementById('quizResult').innerHTML='';showToast('Kuis siap dikerjakan kembali.')}
function saveReflection(){const technique=document.querySelector('input[name="understand"]:checked');if(!technique||!document.getElementById('challenge').value.trim()||!document.getElementById('target').value.trim()){showToast('Pilih teknik dan isi kedua jawaban refleksi terlebih dahulu.');return}state.reflectionSaved=true;document.getElementById('reflectionFeedback').className='feedback correct';document.getElementById('reflectionFeedback').textContent='Refleksi tersimpan selama halaman ini terbuka. Terus berlatih dengan aman!';updateResults()}
function reflectionText(){const technique=document.querySelector('input[name="understand"]:checked');return `REFLEKSI PJOK KELAS VII\nTeknik yang paling dipahami: ${technique?technique.value:'Belum dipilih'}\nBagian yang menantang: ${document.getElementById('challenge').value.trim()}\nTarget latihan: ${document.getElementById('target').value.trim()}\nKomitmen sportivitas: ${document.getElementById('sportive').checked?'Ya':'Belum dicentang'}`}
function copyReflection(){const text=reflectionText();if(!text.includes('Bagian yang menantang: \n')&&!text.includes('Target latihan: \n')){navigator.clipboard?.writeText(text).then(()=>showToast('Refleksi disalin.')).catch(()=>fallbackCopy(text));}else{showToast('Isi refleksi terlebih dahulu agar bisa disalin.')}}function fallbackCopy(t){const ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');showToast('Refleksi disalin.')}catch(e){showToast('Salin teks refleksi secara manual.')}ta.remove()}
function updateResults(){document.getElementById('resultSim').textContent=`${state.simScore}/30`;const done=Object.keys(state.scenarioAnswers).length;document.getElementById('simSummary').textContent=done===3?'Semua skenario selesai.':`${done} dari 3 skenario selesai.`;document.getElementById('resultQuiz').textContent=state.quizScore===null?'—':state.quizScore;document.getElementById('quizSummary').textContent=state.quizScore===null?'Belum ada kuis yang diperiksa.':'Nilai terakhir dari 5 soal pilihan ganda.';document.getElementById('resultReflection').textContent=state.reflectionSaved?'✓':'—';document.getElementById('reflectionSummary').textContent=state.reflectionSaved?'Refleksi sudah diisi.':'Belum disimpan.'}
document.getElementById('audioBtn').addEventListener('click',()=>{state.audio=!state.audio;const b=document.getElementById('audioBtn');b.textContent=state.audio?'🔊 Suara aktif':'🔇 Suara';b.setAttribute('aria-pressed',String(state.audio));showToast(state.audio?'Umpan balik suara belum tersedia; media tetap dapat digunakan tanpa audio.':'Suara nonaktif.')});
renderLesson('passing');renderScenario();renderQuiz();updateProgress();updateResults();
</script>
</body>
